# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (unpooled) connection used by `prisma migrate`. On Neon/Supabase this
# is the non-pooler host; on a plain Postgres it is the same as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""
# Sliding session lifetime and hard cap, in days.
SESSION_IDLE_DAYS="7"
SESSION_ABSOLUTE_DAYS="30"

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# "s3" or "local". Leave unset to use S3 when it is fully configured and local
# disk otherwise in development. Local disk writes to ./.storage (gitignored)
# and is refused in production, where files would not survive a restart.
STORAGE_DRIVER="local"

# S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, MinIO
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Private bucket: customer documents, inspection photos, contracts, signatures.
S3_BUCKET_PRIVATE=""
# Public bucket/prefix: vehicle photos, agency logos, hero images.
S3_BUCKET_PUBLIC=""
# Base URL that serves the public bucket (CDN or bucket endpoint).
S3_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
# Root domain used to resolve {slug}.example.com to an agency. Optional.
APP_ROOT_DOMAIN=""
